{
  "name": "@cambio/testkit",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "tsc -p tsconfig.build.json --watch",
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --dir src"
  },
  "dependencies": {
    "@cambio/engine": "workspace:*",
    "@cambio/protocol": "workspace:*",
    "fast-check": "^4.2.0",
    "pure-rand": "^7.0.1"
  }
}
