{
  "name": "@cambio/tutorial",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./rules": {
      "types": "./dist/rules.d.ts",
      "import": "./dist/rules.js"
    }
  },
  "scripts": {
    "dev": "tsc -p tsconfig.build.json --watch",
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --coverage --dir src"
  },
  "dependencies": {
    "@cambio/engine": "workspace:*",
    "@cambio/protocol": "workspace:*",
    "@cambio/ui": "workspace:*",
    "react": "^19.1.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.10"
  }
}
