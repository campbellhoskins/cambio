{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "types": [
      "node",
      "vite/client"
    ],
    "rootDir": ".",
    "tsBuildInfoFile": "node_modules/.cache/tsconfig.tsbuildinfo",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "vite.config.ts",
    "playwright.config.ts"
  ],
  "exclude": [
    "dist",
    "node_modules",
    "e2e"
  ]
}
