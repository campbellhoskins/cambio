{
  "name": "@cambio/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --dir src",
    "integration": "vitest run --dir test/integration"
  },
  "dependencies": {
    "@cambio/engine": "workspace:*",
    "@cambio/protocol": "workspace:*",
    "@fastify/websocket": "^11.2.0",
    "better-sqlite3": "^12.2.0",
    "drizzle-orm": "^0.44.4",
    "drizzle-zod": "^0.8.3",
    "fastify": "^5.5.0",
    "ws": "^8.18.3",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@cambio/testkit": "workspace:*",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.0",
    "drizzle-kit": "^0.31.4",
    "tsx": "^4.20.3"
  }
}
